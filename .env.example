# Backend configuration (copy to backend/.env or set in your host). Placeholders only.
HUNTFORGE_DB_PATH=./data/huntforge.db
# Comma-separated list of allowed browser origins (your Vercel URL in production)
HUNTFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HUNTFORGE_MAX_UPLOAD_MB=10
HUNTFORGE_MAX_EVENTS=100000
# Requests per minute per client IP
HUNTFORGE_RATE_LIMIT=600
HUNTFORGE_LOG_LEVEL=INFO

# Frontend (set in Vercel project settings, or frontend/.env.local for local dev when not using the Vite proxy)
# Public backend base URL. Must NOT contain secrets: everything VITE_* is bundled into the client.
# VITE_API_URL=https://your-backend.example.onrender.com
